# Copy to .env and adjust. .env is gitignored — never commit real values.
# These are read by doctorhide/settings.py (DATABASES). Defaults target the
# local `docker run` Postgres on host port 5433.
POSTGRES_DB=doctorhide
POSTGRES_USER=doctorhide
POSTGRES_PASSWORD=doctorhide
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
