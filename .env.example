# Copy to .env and adjust. .env is gitignored — never commit real values.
# Every variable below is read by doctorhide/settings.py.

# --- Django core -------------------------------------------------------------
# Toggle debug ("1", "true", or "yes" turns it on). Keep off in production.
DJANGO_DEBUG=true
# Required in production; falls back to an insecure dev key otherwise.
SECRET_KEY=
# "production" enables HTTPS hardening and requires SECRET_KEY. Leave blank for dev.
DJANGO_ENV=
# Comma-separated hosts. Defaults to 127.0.0.1,localhost when unset.
ALLOWED_HOSTS=127.0.0.1,localhost
# Root logging level (default INFO).
LOG_LEVEL=INFO

# --- Docker Compose superuser ------------------------------------------------
# Read by the `init` service to auto-create the admin on first boot.
# DJANGO_SUPERUSER_PASSWORD is REQUIRED for docker compose — it refuses to
# start without it. Username defaults to "admin"; email is optional.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# --- Postgres ----------------------------------------------------------------
# Defaults target the local `docker run` Postgres on host port 5433.
# In docker-compose, set POSTGRES_HOST=db and POSTGRES_PORT=5432 via env.
POSTGRES_DB=doctorhide
POSTGRES_USER=doctorhide
POSTGRES_PASSWORD=doctorhide
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
